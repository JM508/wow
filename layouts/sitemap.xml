{{- /* 自定义网站地图：只收录「可被搜索引擎索引的正式页面」
       · 滤掉 taxonomy / term —— 本站没有文章时它们是空分类页（/categories/、/tags/），收录无意义
       · 滤掉 front matter 里 robotsNoIndex = true 的页面（如 /account/，页面已输出 noindex 元标签，
         地图与 noindex 同时出现属于自相矛盾，会被站长平台报「已提交但被排除」）
       其余输出与 Hugo 内置模板保持一致：loc 必给，lastmod 有则给，changefreq / priority 可选。 */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">{{ range .Pages }}{{ if and (ne .Kind "taxonomy") (ne .Kind "term") (ne .Params.robotsNoIndex true) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode }}" href="{{ .Permalink }}"/>{{ end }}
    {{ end }}
  </url>{{ end }}{{ end }}
</urlset>
